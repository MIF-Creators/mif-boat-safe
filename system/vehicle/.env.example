# MQTT Broker (IP of PC1)
MQTT_BROKER_HOST=192.168.1.100
MQTT_BROKER_PORT=1883

# Vehicle identity
# Each physical vehicle must have a unique VEHICLE_ID and matching ARUCO_MARKER_ID
# The ARUCO_MARKER_ID must be listed in MOBILE_MARKER_IDS on the navigation server
#
# Vehicle 1:  VEHICLE_ID=vehicle_0   ARUCO_MARKER_ID=0
# Vehicle 2:  VEHICLE_ID=vehicle_5   ARUCO_MARKER_ID=5
# Vehicle 3:  VEHICLE_ID=vehicle_6   ARUCO_MARKER_ID=6
VEHICLE_ID=vehicle_0
ARUCO_MARKER_ID=0

# Navigation tuning
POSITION_TOLERANCE=5
ANGLE_TOLERANCE=0.2
NAV_LOOP_RATE_HZ=10

# Motor PWM duty cycle (0-100)
PWM_DUTY_CYCLE=20

# Stop the motors if no drive command arrives for this many seconds (watchdog).
# Must be greater than 1 / NAV_LOOP_RATE_HZ, otherwise the motors will stutter.
DRIVE_COMMAND_TIMEOUT=0.5

# Treat the position as lost if no update arrives for this many seconds;
# the vehicle stops until a fresh position arrives. Keep it several times
# longer than 1 / PUBLISH_RATE_HZ of the navigation server, so a few missed
# camera frames don't stop the vehicle.
POSITION_TIMEOUT=1.0