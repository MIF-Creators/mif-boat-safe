# MQTT Broker (IP of PC1)
MQTT_BROKER_HOST=192.168.1.100
MQTT_BROKER_PORT=1883

# Camera — set CAMERA_RTSP_URL for an IP camera (V4L2 is used when this is empty)
# Example: rtsp://192.168.137.16/onvif1
CAMERA_RTSP_URL=
# TCP (1) vs UDP (0) — try 0 if stream drops after a while
CAMERA_RTSP_TCP=1
# Reconnect after this many failed reads in a row (RTSP timeouts)
CAMERA_RTSP_RECONNECT_AFTER=5
CAMERA_DEVICE=/dev/video0
CAMERA_WIDTH=1280
CAMERA_HEIGHT=720
CAMERA_SKIP_DEVICES=
# Autofocus: 1 = on, 0 = off (leave empty to not change the camera default)
CAMERA_AUTOFOCUS=
# Manual focus value — only takes effect when CAMERA_AUTOFOCUS=0 (leave empty to skip)
CAMERA_FOCUS=

# ArUco markers
# Reference markers define the field corners (fixed, never move)
REFERENCE_MARKER_IDS=1,2,3,4
# Mobile markers — one per vehicle (comma-separated for multiple vehicles)
# Single vehicle:  MOBILE_MARKER_IDS=0
# Two vehicles:    MOBILE_MARKER_IDS=0,5
# Three vehicles:  MOBILE_MARKER_IDS=0,5,6
# Marker ID N maps to vehicle_N (e.g. marker 5 -> vehicle_5)
MOBILE_MARKER_IDS=0

# Map and field calibration (see "Field calibration" in system/README.md)
# At startup the server measures the field from the shape of the reference
# markers 1-4 (squares of one size at the field corners, flat on the floor)
# and publishes no positions until that is done.
# Side of a reference marker along its outer black border, in cm. With it the
# map is in centimetres: (0, 0) is the centre of marker 1, X runs towards
# marker 4, Y towards marker 2. Leave empty for a unitless map: width 100,
# height = 100 / measured aspect ratio.
REFERENCE_MARKER_SIZE_CM=7.5
# Field size in map units (distance between reference marker centres).
# Leave both empty to use the measured size; set both to override it.
MAP_WIDTH=
MAP_HEIGHT=
# Obstacles as JSON array (or empty for no obstacles), in map units (cm with
# REFERENCE_MARKER_SIZE_CM), e.g.
# [{"type": "rectangle", "x": 150, "y": 50, "width": 40, "height": 30},
#  {"type": "circle", "x": 300, "y": 120, "radius": 20}]
MAP_OBSTACLES=[]

# Position publish rate
PUBLISH_RATE_HZ=15

# Live window with video + ArUco overlay (0 = off for headless servers)
SHOW_VIDEO_PREVIEW=1
# PREVIEW_WINDOW_TITLE=Navigation Server
